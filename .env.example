# Copy to .dev.vars and fill in your own keys. Never commit .dev.vars.
SCANNING_ENABLED=true
GOOGLE_SAFE_BROWSING_API_KEY=
VT_API_KEY=
URLHAUS_AUTH_KEY=
IPQS_API_KEY=

# Optional but recommended on Vercel: shared rate-limit counters + result cache.
# Add the "Upstash Redis" integration from the Vercel Marketplace and these fill in automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
